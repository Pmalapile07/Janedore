rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAnyAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAnyAdmin() && adminDoc().role == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isAnyAdmin() && adminDoc().role == 'ADMIN';
    }

    function isVendor() {
      return isAnyAdmin() && adminDoc().role == 'VENDOR';
    }

    function isOwnVendor(vendorId) {
      return isVendor() && adminDoc().vendorId == vendorId;
    }

    function isPlatformStaff() {
      return isSuperAdmin() || isAdmin();
    }

    function noRestrictedFieldsChanged() {
      return !(request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['platformRevenue', 'vendorPayouts', 'payoutStatus',
                 'commissionRate', 'status', 'paymentStatus',
                 'collection', 'collectFrom', 'collectionReminderDue']));
    }

    // Vendors can only update their own profile — not commission or status.
    function vendorProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'brand', 'email', 'description', 'logoUrl', 'heroImageUrl', 'freeDeliveryOffer', 'updatedAt']);
    }

    // A vendor may add/edit tracking only for their own line items on an
    // order they're actually part of (resource.data.vendorIds, written
    // from each line item's own vendorId at order-creation time) — not
    // the order's status/payment, not any other vendor's tracking, not
    // anything else. request.resource.data.vendorTracking is a map
    // keyed by vendorId, e.g. {"vendor-abc": {trackingNumber, courier,
    // addedAt}} — this checks only the caller's OWN key in that map
    // changed. Written as two branches instead of one diff-against-an-
    // empty-map expression: the very first vendor to ever add tracking
    // to an order (vendorTracking doesn't exist on it yet) just needs
    // their new map to contain only their own key; every write after
    // that diffs the new map against the real existing one. The fields
    // *inside* that one entry aren't deep-validated — the bounded worst
    // case is a vendor writing junk into their own tracking entry,
    // never touching another vendor's data, the order total, or
    // payment/status.
    function vendorTrackingOwnEntryOnly() {
      let vid = adminDoc().vendorId;
      return isVendor() &&
             resource.data.vendorIds is list && vid in resource.data.vendorIds &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vendorTracking', 'updatedAt']) &&
             request.resource.data.vendorTracking is map &&
             (
               'vendorTracking' in resource.data
                 ? request.resource.data.vendorTracking.diff(resource.data.vendorTracking).affectedKeys().hasOnly([vid])
                 : request.resource.data.vendorTracking.keys().hasOnly([vid])
             );
    }

    // Inventory writes are server-only. Checkout uses the trusted
    // /api/orders/create transaction; anonymous clients must never update
    // stock or stockByVariant directly.

    // =========================================================
    // PRODUCTS
    // =========================================================

    function sizeGuidePhotoOk() {
      return !(request.resource.data.get('status', '') == 'active' &&
               request.resource.data.get('sizeGuideImage', '') != '' &&
               request.resource.data.get('sizeGuideApproved', false) != true);
    }

    match /products/{productId} {
      allow read: if true;

      // The app never writes status == 'published' — it uses
      // 'active' / 'draft' / 'archived', and 'active' is what the
      // storefront treats as live. Checking against the status value
      // the app actually uses, so a vendor can't self-publish straight
      // to live.
      // Size guide photo (admin-size-guides.js): only a Super Admin
      // approves it, a brand can't keep an approval on a new photo, and
      // no product goes live with a photo that isn't approved.
      allow create: if sizeGuidePhotoOk() && (isSuperAdmin() ||
        (isVendor() &&
         request.resource.data.vendorId == adminDoc().vendorId &&
         request.resource.data.status != 'active' &&
         request.resource.data.get('sizeGuideApproved', false) != true));

      allow update: if sizeGuidePhotoOk() && (isSuperAdmin() ||
        (isVendor() &&
         resource.data.vendorId == adminDoc().vendorId &&
         request.resource.data.vendorId == adminDoc().vendorId &&
         request.resource.data.status != 'active' &&
         (request.resource.data.get('sizeGuideApproved', false) != true ||
          (resource.data.get('sizeGuideApproved', false) == true &&
           request.resource.data.get('sizeGuideImage', '') == resource.data.get('sizeGuideImage', '')))));

      allow delete: if isSuperAdmin() ||
        (isVendor() &&
         resource.data.vendorId == adminDoc().vendorId &&
         resource.data.status != 'active' &&
         resource.data.published != true);
    }

    // Size charts (admin-size-guides.js): one per brand fit, picked on
    // products by sizeGuideId and shown in the shop's Size guide pop-up.
    match /sizeGuides/{guideId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isOwnVendor(request.resource.data.vendorId);
      allow update: if isSuperAdmin() ||
        (isOwnVendor(resource.data.vendorId) && isOwnVendor(request.resource.data.vendorId));
      allow delete: if isSuperAdmin() || isOwnVendor(resource.data.vendorId);
    }

    // =========================================================
    // VENDORS
    // =========================================================

    // Public brand page details only. Contact/login email, commission,
    // PayFast merchant ID and notes live in vendorPrivate below.
    match /vendors/{vendorId} {
      allow read: if true;

      allow create: if isSuperAdmin();

      // Super Admin: full update. Vendor: profile fields only.
      allow update: if isSuperAdmin() ||
        (isOwnVendor(vendorId) && vendorProfileFieldsOnly());

      allow delete: if isSuperAdmin();
    }

    // A brand's private details (admin-vendors.js, server.js getVendors).
    // Staff and the brand itself can read them; only Super Admin writes,
    // except a brand may update its own contact email.
    match /vendorPrivate/{vendorId} {
      allow read: if isPlatformStaff() || isOwnVendor(vendorId);
      allow create: if isSuperAdmin() ||
        (isOwnVendor(vendorId) && request.resource.data.keys().hasOnly(['email', 'updatedAt']));
      allow update: if isSuperAdmin() ||
        (isOwnVendor(vendorId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // ORDERS
    // =========================================================

    match /orders/{orderId} {
      // Customers can read an order that's actually theirs, matched the
      // same way checkout.js and login.js already tie an order to its
      // owner (by uid when signed in at checkout, or by email on the
      // account page's own query). A vendor can read any order that
      // includes at least one of their own items — resource.data.vendorIds
      // is written at order-creation time from each line item's own
      // vendorId (see checkout.js / admin-orders.js's manual order form),
      // so this is full order visibility for every vendor on it, not just
      // their own slice — they just can't edit anything but their own
      // tracking (see the update rule below).
      //
      // Split into get/list (rather than one `read`) on purpose: Firestore
      // can't prove a *list* request (a query) is safe when the rule needs
      // an extra document lookup (adminDoc(), i.e. get()) to decide — it
      // only allows that for a single-document get(). So `list` checks
      // request.auth.token.vendorId instead (a custom claim stamped onto
      // the vendor's own auth token by /api/admin/sync-staff-claims in
      // server.js, kept in sync with their admins/{uid} doc) — no lookup
      // needed, so Firestore can actually evaluate it for a query. `get`
      // keeps using adminDoc() as before, which is fine for a single doc.
      // Matching by email needs a verified email, so nobody can sign up
      // with someone else's address and read their guest orders.
      allow get: if isPlatformStaff() ||
        (isSignedIn() &&
         (resource.data.customerId == request.auth.uid ||
          (request.auth.token.email_verified == true && resource.data.customerEmail == request.auth.token.email))) ||
        (isVendor() && resource.data.vendorIds is list && adminDoc().vendorId in resource.data.vendorIds);

      allow list: if isPlatformStaff() ||
        (isSignedIn() &&
         (resource.data.customerId == request.auth.uid ||
          (request.auth.token.email_verified == true && resource.data.customerEmail == request.auth.token.email))) ||
        (request.auth.token.role == 'VENDOR' && request.auth.token.vendorId is string &&
         resource.data.vendorIds is list && request.auth.token.vendorId in resource.data.vendorIds);

      // Orders are created by the trusted server-side checkout endpoint.
      // Staff may still create orders through the admin workflows.
      allow create: if isPlatformStaff();

      allow update: if isAdmin() && noRestrictedFieldsChanged();

      allow update: if isSuperAdmin();

      // A vendor adding/editing tracking for their own items — see
      // vendorTrackingOwnEntryOnly() above for exactly what this allows.
      allow update: if vendorTrackingOwnEntryOnly();

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // ORDER DRAFTS
    // =========================================================

    match /order_drafts/{draftId} {
      allow read, write: if isPlatformStaff();
    }

    // =========================================================
    // REVIEWS
    // =========================================================

    match /reviews/{reviewId} {
      allow read: if true;

      // Written only by the server (reviews-api.js), after it checks the
      // reviewer bought the product. No direct writes from the site.
      allow create: if false;

      allow update: if isSuperAdmin() || isAdmin() ||
        (isVendor() &&
         resource.data.vendorId == adminDoc().vendorId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vendorReply', 'vendorRepliedAt']));

      allow delete: if isSuperAdmin() || isAdmin();
    }

    // Who wrote each review (email, account): server only, readable by
    // admins. Kept apart from reviews/{id}, which anyone can read.
    match /reviewOwners/{reviewId} {
      allow read: if isSuperAdmin() || isAdmin();
      allow write: if false;
    }

    // =========================================================
    // NEWSLETTER
    // =========================================================

    match /newsletter/{docId} {
      // Read/update are staff-only; create stays public (signup has to
      // work for anonymous visitors) but is restricted to the exact
      // fields your two signup flows (firebase.js and the coming-soon
      // page) actually write.
      allow read, update: if isPlatformStaff();
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source', 'userAgent', 'referrer']) &&
        request.resource.data.email is string && request.resource.data.email.size() > 0;
      allow delete: if isPlatformStaff();
    }

    // =========================================================
    // CUSTOMERS
    // =========================================================

    match /customers/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow read, update: if isPlatformStaff() ||
        (isSignedIn() && request.auth.uid == userId);

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // ADMINS
    // =========================================================

    match /admins/{adminId} {
      // Super Admin: full read. Each user can read their own doc (needed for role loading).
      allow read: if isSuperAdmin() ||
                     (isSignedIn() && request.auth.uid == adminId);

      // Only Super Admin can create admin records (including vendor accounts)
      allow create: if isSuperAdmin();

      // Super Admin: full update. Users can update their own non-role fields only.
      allow update: if isSuperAdmin() ||
        (isSignedIn() && request.auth.uid == adminId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastLogin', 'updatedAt']));

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // VENDOR SALES
    // =========================================================

    match /vendor_sales/{vendorId} {
      allow read: if isSuperAdmin() || isOwnVendor(vendorId);
      allow write: if isSuperAdmin();
    }

    // =========================================================
    // SETTINGS
    // =========================================================

    // onlineStoreSecrets (the visitor password) gets its own rule, Super
    // Admin only — nothing else needs to see it, since the public-facing
    // password check already goes through the server, not this rule.
    match /settings/onlineStoreSecrets {
      allow read, write: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if isPlatformStaff() || isVendor();
      allow write: if isSuperAdmin();
    }

    // =========================================================
    // PAGES
    // =========================================================

    match /pages/{pageId} {
      // Public can read published pages (storefront)
      allow read: if true;

      // Only Super Admin can create / edit / delete pages
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // COLLECTIONS (published storefront records + scoped management)
    // =========================================================

    match /collections/{collectionId} {
      // Public storefront queries must constrain status == 'active'.
      // Staff can inspect all records; vendors can inspect their own.
      allow read: if resource.data.status == 'active' ||
        isPlatformStaff() ||
        (isVendor() && resource.data.vendorId == adminDoc().vendorId);

      allow create: if isSuperAdmin() ||
        (isVendor() &&
         request.resource.data.vendorId == adminDoc().vendorId &&
         request.resource.data.status != 'active' &&
         request.resource.data.published != true);

      allow update: if isSuperAdmin() ||
        (isVendor() &&
         resource.data.vendorId == adminDoc().vendorId &&
         request.resource.data.vendorId == adminDoc().vendorId &&
         request.resource.data.status != 'active' &&
         request.resource.data.published != true);

      allow delete: if isSuperAdmin() ||
        (isVendor() && resource.data.vendorId == adminDoc().vendorId);
    }

    // =========================================================
    // CATEGORIES (storefront reads; Super Admin manages)
    // =========================================================

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // SITE CONTENT (homepage hero/sections + collection page titles)
    // =========================================================

    match /siteContent/{docId} {
      // Public can read (storefront renders the homepage/collection
      // pages from this — see site-content.js)
      allow read: if true;

      // Only Super Admin can create / edit / delete — same access level
      // as Pages above (admin-homepage.js's "Homepage" tab is gated the
      // same way).
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // DISCOUNTS
    // =========================================================

    match /discounts/{discountId} {
      // Staff only, so nobody can list every code. Shoppers check one code
      // at a time through server.js /api/discounts/lookup.
      allow read: if isPlatformStaff() || isVendor();

      // Platform staff can create discounts
      allow create: if isPlatformStaff();

      // Platform staff can update discounts
      allow update: if isPlatformStaff();

      // Only Super Admin can delete discounts
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // DISCOUNT CODES
    // =========================================================

    match /discountCodes/{codeId} {
      // Staff only (not used by the storefront).
      allow read: if isPlatformStaff();

      // Platform staff can create discount codes
      allow create: if isPlatformStaff();

      // Platform staff can update discount codes
      allow update: if isPlatformStaff();

      // Only Super Admin can delete discount codes
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // MISSION CONTROL COLLECTIONS
    // =========================================================

    match /brands/{docId}         { allow read: if true; allow write: if isPlatformStaff(); }
    match /suppliers/{docId}      { allow read, write: if isPlatformStaff(); }
    match /samples/{docId}        { allow read, write: if isPlatformStaff(); }
    match /campaigns/{docId}      { allow read, write: if isPlatformStaff(); }
    match /admin_launch/{docId}   { allow read, write: if isPlatformStaff(); }
    match /launch_projects/{docId}{ allow read, write: if isPlatformStaff(); }
    match /milestones/{docId}     { allow read, write: if isPlatformStaff(); }
    match /recent_wins/{docId}    { allow read, write: if isPlatformStaff(); }
    match /waiting_on/{docId}     { allow read, write: if isPlatformStaff(); }

    match /founder_notes/{docId}  { allow read, write: if isSuperAdmin(); }

    // =========================================================
    // CHAT FALLBACK (Firestore legacy — real chat is in RTDB)
    // =========================================================

    // Old chat collections: live chat now runs on the Realtime Database
    // (chat.js), so nothing creates these any more.
    match /chats/{docId}    { allow read, update, delete: if isPlatformStaff(); }
    match /messages/{docId} { allow read, update, delete: if isPlatformStaff(); }

    // =========================================================
    // HEALTH CHECK
    // =========================================================

    match /_health_check/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
